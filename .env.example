# ─── Database ──────────────────────────────────────────────────
DB_PASSWORD=ptapp_secret

# ─── JWT ───────────────────────────────────────────────────────
# String random panjang, minimal 32 karakter
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_32_karakter

# ─── Port ──────────────────────────────────────────────────────
FRONTEND_PORT=8500

# ─── Microsoft Teams (opsional) ───────────────────────────────
TEAMS_WEBHOOK_URL=

# ─── Email notifications (opsional, SMTP Office 365) ──────────
MAIL_NOTIFICATIONS_ENABLED=false
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Set ke false kalau pakai SMTP catcher lokal (mis. Mailpit) yang tidak butuh auth/TLS
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
